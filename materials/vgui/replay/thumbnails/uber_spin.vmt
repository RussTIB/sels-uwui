"UnlitGeneric"
{
	"$baseTexture" "vgui/replay/thumbnails/uber_spin"
	"$translucent"		"1"
	"$vertexcolor"		"1"
	"$vertexalpha"		"1"
	"$ignorez"			"1"
	"$additive"			0
	"$no_fullbright"	1
	"%keywords" "tf"

    "$angle" 0.0
    "$allenscott_scale" -1.00
    "$allenscott_center" "[0.5 0.5]"

    "Proxies"
        {
            "LinearRamp"
            {
                "rate" -65
                "initialValue" 0.0
                "resultVar" "$angle"
            }

            "TextureTransform"
            {
                "translateVar" "$translate"
                "rotateVar" "$angle"
                "scaleVar" "$allenscott_scale"
                "centerVar" "$allenscott_center"
                "resultVar" "$basetexturetransform"
            }
        }
}