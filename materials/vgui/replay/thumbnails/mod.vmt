"Modulate"
{
	"$baseTexture" "vgui/replay/thumbnails/modulatetest"
	"$vertexalpha" 1
	"$translucent" 1
	"$additive" 1

	"Proxies"
                {
	          "AnimatedTexture"
	          {
                                             "animatedtexturevar" "$basetexture"
                                             "animatedtextureframenumvar" "$frame"
                                             "animatedtextureframerate" 18
	          }
		}
}